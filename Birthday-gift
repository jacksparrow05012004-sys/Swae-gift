<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Happy Birthday 🎉</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    body {
      background: linear-gradient(135deg, #ff9a9e, #fad0c4);
      overflow: hidden;
    }

    .glow {
      animation: glow 2s infinite alternate;
    }

    @keyframes glow {
      from {
        text-shadow: 0 0 10px #ff4da6, 0 0 20px #ff4da6;
      }
      to {
        text-shadow: 0 0 20px #ff1a8c, 0 0 40px #ff1a8c;
      }
    }

    .floating-hearts {
      position: fixed;
      font-size: 24px;
      animation: floatUp 6s linear infinite;
      opacity: 0.7;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(100vh) scale(1);
        opacity: 0;
      }
      20% {
        opacity: 1;
      }
      100% {
        transform: translateY(-120vh) scale(1.5);
        opacity: 0;
      }
    }
  </style>
</head>

<body class="min-h-screen flex items-center justify-center px-4">

  <div class="bg-white/90 backdrop-blur-md shadow-2xl rounded-3xl p-6 sm:p-8 max-w-md w-full text-center border-4 border-pink-300">

    <h1 class="text-3xl sm:text-5xl font-extrabold text-pink-500 mb-4 glow">
      🎂 Happy Birthday Darling Swaeee 💋
    </h1>

    <p class="text-base sm:text-lg text-gray-700 mb-6 leading-relaxed">
      Wishing you a day filled with endless love 💖, happiness 🌸,
      cute smiles 😊, warm hugs 🤗, and unforgettable memories ✨.
      <br><br>
      May your life always shine brighter than the stars 🌟
      and may all your dreams come true 💕
    </p>

    <div class="text-5xl sm:text-6xl mb-6 animate-bounce">
      🎉🎈🎁💖
    </div>

    <p class="text-gray-600 italic text-sm sm:text-base">
      "Every moment with you feels magical ✨"
    </p>

    <button
      onclick="celebrate()"
      class="mt-6 px-6 py-3 bg-pink-500 text-white rounded-2xl shadow-lg hover:bg-pink-600 transition-all duration-300 hover:scale-105 w-full sm:w-auto"
    >
      Click for a Surprise 🎊
    </button>

    <p id="surprise"
       class="mt-4 text-lg sm:text-2xl font-bold text-purple-600 hidden">
       I Love You So Much Darling Swaeee 💋💖
    </p>

  </div>

  <script>
    function celebrate() {

      document.getElementById('surprise').classList.remove('hidden');

      confetti({
        particleCount: 200,
        spread: 90,
        origin: { y: 0.6 }
      });

      setTimeout(() => {
        confetti({
          particleCount: 150,
          angle: 60,
          spread: 100,
          origin: { x: 0 }
        });

        confetti({
          particleCount: 150,
          angle: 120,
          spread: 100,
          origin: { x: 1 }
        });
      }, 400);

      createHearts();
    }

    function createHearts() {
      for (let i = 0; i < 20; i++) {

        const heart = document.createElement("div");

        heart.classList.add("floating-hearts");

        heart.innerHTML = "💖";

        heart.style.left = Math.random() * 100 + "vw";

        heart.style.animationDuration =
          (Math.random() * 3 + 3) + "s";

        document.body.appendChild(heart);

        setTimeout(() => {
          heart.remove();
        }, 6000);
      }
    }
  </script>

</body>
</html>
